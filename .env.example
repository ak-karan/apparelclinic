# Gmail SMTP settings for Nodemailer backend
# Use a Gmail App Password, not your normal Gmail password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_TO=where-you-want-to-receive-mail@gmail.com

# Optional: override frontend form endpoints if your backend lives elsewhere
# VITE_PICKUP_FORM_ENDPOINT=https://your-domain.com/api/pickup
# VITE_CONTACT_FORM_ENDPOINT=https://your-domain.com/api/contact
# VITE_REVIEWS_ENDPOINT=https://your-domain.com/api/reviews

# Optional: persist live reviews through the GitHub API from Vercel/serverless
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_REPO=your-user/your-repo
# GITHUB_BRANCH=master
# GITHUB_REVIEWS_PATH=data/reviews.json
